{
  "version": 4,
  "configurations": [
    {
      "name": "macOS-Clang",
      "compilerPath": "/usr/bin/clang++",
      "intelliSenseMode": "macos-clang-arm64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/thirdParty/glfw/include",
        "${workspaceFolder}/thirdParty/imgui",
        "${workspaceFolder}/thirdParty/imgui/backends",
        "${workspaceFolder}/thirdParty/EASTL/include",
        "${workspaceFolder}/thirdParty/EABase/include/Common",
        "${workspaceFolder}/thirdParty/metal-cpp",
        "${workspaceFolder}/thirdParty/metal-cpp/metal-cpp"
      ],
      "defines": []
    },
    {
      "name": "Windows-MSVC",
      "compilerPath": "cl.exe",
      "intelliSenseMode": "windows-msvc-x64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/thirdParty/glfw/include",
        "${workspaceFolder}/thirdParty/imgui",
        "${workspaceFolder}/thirdParty/imgui/backends",
        "${workspaceFolder}/thirdParty/EASTL/include",
        "${workspaceFolder}/thirdParty/EABase/include/Common"
      ],
      "defines": []
    },
    {
      "name": "Linux-GCC",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/thirdParty/glfw/include",
        "${workspaceFolder}/thirdParty/imgui",
        "${workspaceFolder}/thirdParty/imgui/backends",
        "${workspaceFolder}/thirdParty/EASTL/include",
        "${workspaceFolder}/thirdParty/EABase/include/Common"
      ],
      "defines": []
    }
  ]
}
