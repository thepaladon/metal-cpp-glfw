{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Debug (macOS LLDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/metal_cpp_test",
      "args": [],
      "cwd": "${workspaceFolder}/build",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "lldb",
      "preLaunchTask": "cmake: build debug"
    },
    {
      "name": "Launch Release (macOS LLDB)",
      "type": "cppdbg",
      "request": "launch",
